[
  {
    "name": "lookup",
    "description": "Read a synthetic record by key. Unknown keys return an error.",
    "schema": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        }
      },
      "required": [
        "key"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "calculate",
    "description": "Calculate a binary arithmetic operation on integers.",
    "schema": {
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "add",
            "subtract",
            "multiply"
          ]
        },
        "a": {
          "type": "integer"
        },
        "b": {
          "type": "integer"
        }
      },
      "required": [
        "op",
        "a",
        "b"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "submit_answer",
    "description": "Submit the final answer as a JSON object. Call exactly once after completing the task.",
    "schema": {
      "type": "object",
      "properties": {
        "answer": {
          "type": "object"
        }
      },
      "required": [
        "answer"
      ],
      "additionalProperties": false
    }
  }
]
